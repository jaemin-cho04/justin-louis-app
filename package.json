{
  "name": "progress-app",
  "description": "A local-first social productivity app for habits, projects, and close-friend accountability.",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:brand": "node scripts/check-brand-config.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:progress": "tsc -p tsconfig.test.json && node tmp/test-build/scripts/progress-tests.js",
    "test": "npm run check:lines && npm run check:brand && npm run check:accessibility && npm run check:architecture && npm run test:progress",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.11",
    "typescript": "~5.9.2"
  }
}
